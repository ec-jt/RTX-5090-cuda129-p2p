From 215c492fcd3d5230a7abe42ffa1215a39da31593 Mon Sep 17 00:00:00 2001
From: aikitoria <aikitoria@gmail.com>
Date: Sat, 7 Dec 2024 10:17:18 +0100
Subject: [PATCH] Simplified p2p mod based on the one by geohot

---
 install.sh                                    |  7 ++++
 kernel-open/nvidia/nv-pci.c                   |  4 +-
 src/nvidia/generated/g_kern_bus_nvoc.c        | 10 ++---
 src/nvidia/src/kernel/gpu/bif/kernel_bif.c    |  4 +-
 .../gpu/bus/arch/pascal/kern_bus_gp100.c      | 10 +++++
 src/nvidia/src/kernel/rmapi/nv_gpu_ops.c      | 37 ++++++++++++++-----
 src/nvidia/src/libraries/mmu/gmmu_fmt.c       |  3 +-
 7 files changed, 54 insertions(+), 21 deletions(-)
 create mode 100755 install.sh

diff --git a/install.sh b/install.sh
new file mode 100755
index 0000000000..d11f1eddc7
--- /dev/null
+++ b/install.sh
@@ -0,0 +1,7 @@
+#!/bin/bash
+sudo rmmod nvidia_drm nvidia_modeset nvidia_uvm nvidia
+set -e
+make modules -j$(nproc)
+sudo make modules_install -j$(nproc)
+sudo depmod
+nvidia-smi
diff --git a/kernel-open/nvidia/nv-pci.c b/kernel-open/nvidia/nv-pci.c
index 4bedd72cf1..595d47327a 100644
--- a/kernel-open/nvidia/nv-pci.c
+++ b/kernel-open/nvidia/nv-pci.c
@@ -187,11 +187,11 @@ static int nv_resize_pcie_bars(struct pci_dev *pci_dev) {
     struct pci_host_bridge *host;
 #endif
 
-    if (NVreg_EnableResizableBar == 0)
+    /*if (NVreg_EnableResizableBar == 0)
     {
         nv_printf(NV_DBG_INFO, "NVRM: resizable BAR disabled by regkey, skipping\n");
         return 0;
-    }
+    }*/
 
     // Check if BAR1 has PCIe rebar capabilities
     sizes = pci_rebar_get_possible_sizes(pci_dev, NV_GPU_BAR1);
